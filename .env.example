# ─── PRIVACYOS · Variables de entorno ─────────────────────────────
# Copia este archivo como `.env.local` para desarrollo local.
# NO incluyas secretos reales en el repositorio.

# URL pública del despliegue (usada para metadata/canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tiempo máximo (ms) que espera el motor de análisis por sitio externo.
# Valores recomendados: 6000–10000. Debe mantenerse por debajo del
# límite de ejecución de la función serverless de tu plan de Vercel.
ANALYZE_TIMEOUT_MS=8000

# Límite de lectura del HTML inicial, en bytes (prevento de descargas enormes).
ANALYZE_MAX_BODY_BYTES=512000

# Máximo de redirecciones seguidas (cada destino se vuelve a validar por SSRF).
ANALYZE_MAX_REDIRECTS=3

# ─── Preparado para Hito 2 (NO activar todavía) ───────────────────
# DATABASE_URL=            # Postgres/Supabase (futuro)
# NEXT_PUBLIC_DATA_SOURCE= # "live" | "api" (futuro adaptador de backend)
