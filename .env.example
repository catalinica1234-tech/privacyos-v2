# PRIVACYOS · Variables de entorno
# Copia este archivo como `.env.local` para desarrollo local.
# NO incluyas secretos reales en el repositorio.

# URL pública del despliegue (usada para metadata/canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tiempo máximo (ms) que espera el motor de análisis por sitio externo.
# Valores recomendados: 6000–10000. Debe mantenerse por debajo del
# límite de ejecución de la función serverless de tu plan de Vercel.
ANALYZE_TIMEOUT_MS=8000

# Límite de lectura del HTML inicial, en bytes (previene descargas enormes).
ANALYZE_MAX_BODY_BYTES=512000

# Máximo de redirecciones seguidas (cada destino se revalida por SSRF).
ANALYZE_MAX_REDIRECTS=3

# ─── Hito 2 · Base de datos (Prisma + PostgreSQL / Supabase) ───
# Formato de ejemplo, NO es una credencial real. El valor verdadero
# va en .env.local y nunca se sube al repositorio.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/privacyos?schema=public

# ─── Hito 2 · Asistente explicativo (IA, opcional) ───
# 1 = activado · 0 o ausente = desactivado (la app funciona sin esto).
# La clave del proveedor de IA va SOLO en .env.local / panel del proveedor
# de despliegue: nunca en el código ni en el repositorio.
ASSISTANT_ENABLED=1
ASSISTANT_MODEL=gemini-3.8-flash
GEMINI_API_KEY=PEGA-TU-CLAVE-AQUI

# Correo visible al usuario en la app (no es un secreto).
CONTACTO_EMAIL=contacto@ejemplo.cl
